# ==============================================================
# QUICK KARYA ENVIRONMENT CONFIGURATION (.env)
# ==============================================================

# 1. CORE APPLICATION
# --------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# 2. REAL SMS OTP GATEWAY INTEGRATION
# Configure ANY ONE of the following SMS providers for real mobile OTP dispatch:
#
# Option A: Fast2SMS (Indian SMS Gateway - Recommended for India)
# Get API key from https://www.fast2sms.com/
FAST2SMS_API_KEY=""
#
# Option B: Twilio SMS (Global SMS Gateway)
# Get credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
#
# Option C: MSG91 (DLT Approved Indian SMS Gateway)
# Get credentials from https://msg91.com/
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
#
# Option D: Textlocal (Indian SMS Gateway)
# Get credentials from https://www.textlocal.in/
TEXTLOCAL_API_KEY=""
TEXTLOCAL_SENDER="TXTLCL"

# 3. PRIVATE CALLING & CALLER ID MASKING PROVIDER
# Supported providers: "exotel" | "twilio"
CALL_PROVIDER="exotel"
QUICK_KARYA_CALLER_ID=""
#
# Exotel Configuration (India):
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_VIRTUAL_NUMBER=""

# 4. TARGETED WORKER PUSH NOTIFICATIONS (FCM)
# Firebase Cloud Messaging Server Key for routing alerts to worker device tokens:
FCM_SERVER_KEY=""
