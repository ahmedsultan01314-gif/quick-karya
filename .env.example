# Quick Karya Caller ID & Business Calling Masking Provider
# (Exotel / Twilio / Knowlarity Virtual Business Number)
QUICK_KARYA_CALLER_ID="+9180XXXXXXXX"
CALL_PROVIDER="exotel"
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_VIRTUAL_NUMBER=""

# Optional Twilio SMS / Voice Configuration
TWILIO_ACCOUNT_SID=""
